# Local sample-only Protected Resource service. Contains no credentials.
PROTECTED_RESOURCE_ADDRESS=:8086
PROTECTED_RESOURCE_REQUEST_TIMEOUT=5s
PROTECTED_RESOURCE_SLOW_DELAY=2s
PROTECTED_RESOURCE_MODE=sample
# sample (default) or sample-alternative. Both remain deterministic sample adapters.
PROTECTED_RESOURCE_ADAPTER_MODE=sample
PROTECTED_RESOURCE_LOG_LEVEL=info
# Read-only cloud inventory adapter: cloud-api (docs/api-dock.md). Mount a file containing the token;
# never put its contents in this environment file or Helm values. The Resource checks the API's
# interface before it serves and does not start if the check fails.
# PROTECTED_RESOURCE_ADAPTER_MODE=cloud-api
# PROTECTED_RESOURCE_CLOUD_TOKEN_FILE=/var/run/cloud-api/token
# PROTECTED_RESOURCE_CLOUD_API_URL=https://api.ionos.com/cloudapi/v6
# PROTECTED_RESOURCE_CLOUD_CA_FILE=
