# The base of the admission test images: a small runnable linux/amd64 image (the manifest digest, not
# the index) with a package database, so its Syft SBOM lists components.
TEST_BASE_IMAGE=docker.io/library/alpine:3.22@sha256:3e9b4b680bfc9fb5269227cffbd6d42be39fbf7c0b908123913864aa4447e764

# The OCM W-Stack wallet lane (scripts/verify-ocm-wallet, deployment/helm/ocm-wallet and
# ocm-backbone): the W-Stack images from the XFSC Harbor on the client's registry host and the
# stores and helpers from Docker Hub, by digest. A zone file copies these digests; the proof
# installs them. Multi-architecture index digests except where noted.
OCM_SIGNER_IMAGE=node-654e3bca7fbeeed18f81d7c7.ps-xaas.io/tsa/signer:2.3.9@sha256:e22095d7e0d9f210603470b230858b99e3edcecd69293d644653e635298e99cd
