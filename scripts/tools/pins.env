GATEKEEPER_CRDS_IMAGE=openpolicyagent/gatekeeper-crds:v3.23.1@sha256:ab3620e6bec901e2a3f71ea4a65e589cc2b8b362a9836832dd0cc6ff916e4ce5

# kind and kubectl for the admission job in CI: a throwaway cluster with Gatekeeper, the provider and a
# local registry. The node image matches the Kubernetes minor version of the IONOS cluster.
KIND_VERSION=v0.33.0
KIND_SHA256=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
KIND_NODE_IMAGE=kindest/node:v1.35.8@sha256:07b2536e30b803ed61d1677a79df6115f798ce64c80f9e22f6ed45afd09323c0
# The Cilium CLI, which scripts/dev/kind-cilium-up.sh waits on (the kind run of the observability proof).
CILIUM_CLI_VERSION=v0.20.1
CILIUM_CLI_SHA256=24e817dcfcc8a12e325ce7547617bcbcf171c5b0b335bb24d2bb1207ba047f61
KUBECTL_VERSION=v1.35.8
KUBECTL_SHA256=874d5e72dbb819f43cff16bcd1e4f8bac5b7f2361fe1e55049b0a6c676fb0cbf

# The Cilium CRDs the umbrella renders against (CiliumClusterwideNetworkPolicy, CiliumNetworkPolicy),
# for the release chart gate's server dry-run on a cluster without Cilium. Same Cilium version as
# scripts/dev/kind-cilium-up.sh.
CILIUM_CRDS_VERSION=1.20.2
CILIUM_CCNP_CRD_SHA256=ae65e44fdee9da399cb7257a8464f197bea5270fdc213f6343700309c39abad6
CILIUM_CNP_CRD_SHA256=62c6de8f358da125b94468d39187edb1cea157d79503fdc50ccec8a6aaa79a76

# Test services (CI integration jobs only; never shipped).
POSTGRES_IMAGE=postgres:16.10-alpine@sha256:029660641a0cfc575b14f336ba448fb8a75fd595d42e1fa316b9fb4378742297
OPENBAO_IMAGE=openbao/openbao:2.7.0@sha256:71156a1c6623a5fa3f5e61b0c6a8ead0faf0df29a778339188443551995d1315
REGISTRY_IMAGE=registry:2.8.3@sha256:a3d8aaa63ed8681a604f1dea0aa03f100d5895b6a58ace528858a7b332415373
# The base of the admission test images: a small runnable linux/amd64 image (the manifest digest, not
# the index) with a package database, so its Syft SBOM lists components.
TEST_BASE_IMAGE=docker.io/library/alpine:3.22@sha256:3e9b4b680bfc9fb5269227cffbd6d42be39fbf7c0b908123913864aa4447e764

# The observability stack (docs/dependencies.md, "Observability"): the upstream charts, each pinned by
# version and by the sha256 of its archive (the digest its repository's index.yaml publishes), and the
# images they run, each pinned by tag and by the multi-arch index digest of the tag
# (`docker buildx imagetools inspect <image>:<tag>`). scripts/install-zone/install.sh reads these and
# sets the images on the charts; nothing else names a version.
#   OpenTelemetry Collector chart (open-telemetry.github.io/opentelemetry-helm-charts): the node
#   collectors and the zone gateway of a participant zone, the receiving collector of the
#   demonstrator cluster, all on the contrib image.
OTEL_COLLECTOR_CHART_REPO=https://open-telemetry.github.io/opentelemetry-helm-charts
OTEL_COLLECTOR_CHART_VERSION=0.176.1
OTEL_COLLECTOR_CHART_SHA256=ae07bbaf11e08f33817301d1c19876b6c2284ffb91599fc4519d23193b1987ac
OTEL_COLLECTOR_IMAGE=docker.io/otel/opentelemetry-collector-contrib:0.162.0@sha256:39923a8e431bd1f57be82411999d389fcfe40857492e4365456d97a4c1f74be6
#   Prometheus and Alertmanager charts (prometheus-community.github.io/helm-charts), the central
#   metrics store and the alert route of the demonstrator cluster.
PROMETHEUS_CHART_REPO=https://prometheus-community.github.io/helm-charts
PROMETHEUS_CHART_VERSION=29.37.0
PROMETHEUS_CHART_SHA256=df07dce99f49ea300c5bb8dadb167a09141bb7dbdc6609727157677434e4fbe5
PROMETHEUS_IMAGE=quay.io/prometheus/prometheus:v3.15.0@sha256:efd719c99d83b060d9daefdcf00360461adf279f45ef5391f8d111892118753e
ALERTMANAGER_CHART_VERSION=2.1.1
ALERTMANAGER_CHART_SHA256=c9cc195fd034992402559750ec86f1a87b4f760260b9e2bd707428a43d768b5c
ALERTMANAGER_IMAGE=quay.io/prometheus/alertmanager:v0.34.1@sha256:e9733bafb1bdef9b00e25a21f8f99dc26a22224bf16641ad754d1649f4c3357a
#   The configuration reloader both charts run beside the server.
CONFIG_RELOADER_IMAGE=quay.io/prometheus-operator/prometheus-config-reloader:v0.94.1@sha256:06b52bd4dbe3ed6dd5905aadaf8b9987d9da4c31d37bb86deaadae68cee2d26b
#   Jaeger chart (jaegertracing.github.io/helm-charts), Jaeger v2 all-in-one with Badger storage on a
#   persistent volume: the central trace store of the demonstrator cluster.
JAEGER_CHART_REPO=https://jaegertracing.github.io/helm-charts
JAEGER_CHART_VERSION=4.16.1
JAEGER_CHART_SHA256=b33c73f3b45f23a4bdacbb915eaf7961b79e10ca7804f1ebdd61a5ccec1c3b9b
JAEGER_IMAGE=docker.io/jaegertracing/jaeger:2.22.0@sha256:836b967b5abcf1f7758066aa6b348619267a2f1459f72d472840570f9bd88a17
#   cert-manager (charts.jetstack.io), on kind only: the demonstrator cluster runs its own cert-manager
#   (v1.21.2, found installed), which the telemetry issuers use. scripts/dev/kind-cert-manager-up.sh
#   installs the same version on kind, where the two roles share one cluster.
CERT_MANAGER_CHART_REPO=https://charts.jetstack.io
CERT_MANAGER_CHART_VERSION=v1.21.2
CERT_MANAGER_CHART_SHA256=73a56e1728edd6c99f1f31082618c3259d279a76b7ebd3d4bdc5475c2442d34a
CERT_MANAGER_CONTROLLER_IMAGE=quay.io/jetstack/cert-manager-controller:v1.21.2@sha256:70f532fd9cfde0b09d55687200942399d89838bc2d5d5b45152eb799a15912b8
CERT_MANAGER_CAINJECTOR_IMAGE=quay.io/jetstack/cert-manager-cainjector:v1.21.2@sha256:c85268c64f2e0e76684bf5fe8906caff34b82523561c6affe0fae3546bd87562
CERT_MANAGER_WEBHOOK_IMAGE=quay.io/jetstack/cert-manager-webhook:v1.21.2@sha256:a60e2dac46dbb8a7f3df95c54ce941012f54c2fe022f0ee55aaa1ab40ed957ae
CERT_MANAGER_STARTUPAPICHECK_IMAGE=quay.io/jetstack/cert-manager-startupapicheck:v1.21.2@sha256:46e75b6866359ffb5d82624f41e3ed1c70b2994982702ced547ce5edb418a8f5
CERT_MANAGER_ACMESOLVER_IMAGE=quay.io/jetstack/cert-manager-acmesolver:v1.21.2@sha256:699b40d622211ab7accad8a21b04c5fbaa1841ef7a12621e8de492dbe27b2503
