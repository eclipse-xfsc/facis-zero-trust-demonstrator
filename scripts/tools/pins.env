# Pinned supply-chain and policy tooling, with the SHA-256 of each linux/amd64 release asset.
# CI installs from here (scripts/tools/install.sh); a change is a reviewed change of this file.

COSIGN_VERSION=v2.6.2
COSIGN_SHA256=d437b8f0d30f5dec169337607fcfa0238de1348503e175f1bb5b94330b1ee409

SYFT_VERSION=1.52.0
SYFT_SHA256=caeedb81fb0491615f1ebd1761e4145d41ee86dd2cc7bf80669f9f5ad9d6133d

GRYPE_VERSION=0.119.0
GRYPE_SHA256=3fa2dc4b924621ab65404cf08d0b8438d896d80ab949c9d5a4ca283c36004c9b

GATOR_VERSION=v3.23.1
GATOR_SHA256=c268d7b809c9fe59a110ab0bf7c296ab00b0b6c894c209cd15e94194590291bb

# Gatekeeper: the Helm chart (open-policy-agent.github.io/gatekeeper/charts, digest from its index.yaml)
# and the images it deploys, pinned by digest in the chart values.
GATEKEEPER_CHART_VERSION=3.23.1
GATEKEEPER_CHART_SHA256=a944e64fa3587325b6dde41cd9f4480ee6767ef78346864b5d17469b522a1e55
